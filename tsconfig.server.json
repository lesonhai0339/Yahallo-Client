{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "outDir": "./out-tsc/server",
    /* `server.ts` nam o goc project, ngoai `rootDir: ./src` cua tsconfig goc —
       noi rong ra thu muc goc, neu khong TS bao TS6059. */
